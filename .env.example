# LOCAL SETUP ONLY.
# Copy this file to .env. Install and first boot must replace every CHANGE_ME
# with a unique value before containers start. Do not reuse these placeholders
# on a shared or public host, and never commit .env.

APP_NAME="Lumina GIS"

# Open public signup. Leave false so people join an organization by invite.
ALLOW_REGISTRATION=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgis
DB_PORT=5432
DB_DATABASE=laravel_gis
DB_USERNAME=postgres
# Required before first boot. Replace CHANGE_ME with a unique password.
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MapBox Configuration (for map tiles)
# Get your token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# GeoServer Configuration
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_PUBLIC_URL=http://127.0.0.1:8081/geoserver
GEOSERVER_ADMIN_USER=admin
# Required before first boot. Replace CHANGE_ME with a unique password.
GEOSERVER_ADMIN_PASSWORD=CHANGE_ME
GEOSERVER_WORKSPACE=webgis
GEOSERVER_DATASTORE=postgis_store
MAP_ICON_BASE_URL=http://nginx/map-icons

# Data Import Configuration
OGR2OGR_PATH=/usr/bin/ogr2ogr
OGRINFO_PATH=/usr/bin/ogrinfo
DATA_IMPORT_DISK=local
DATA_IMPORT_MAX_FILE_SIZE=104857600
DATA_IMPORT_TABLE_PREFIX=import_
DATA_IMPORT_DEFAULT_SRID=4326
DATA_IMPORT_TIMEOUT=300

# Laravel AI SDK (https://laravel.com/docs/ai-sdk)
# Default provider is openai; set the matching key for the provider you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Geocoding (Nominatim-compatible)
GEOCODE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT="GIS-App/1.0 (contact@example.com)"
GEOCODE_LIMIT=10
GEOCODE_TIMEOUT=10

# Print / PDF
PRINT_PAPER=a4
PRINT_ORIENTATION=landscape
PRINT_USE_DOMPDF=true
