APP_NAME="Laravel WebGIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily,slack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database
DB_CONNECTION=pgsql
DB_HOST=postgis
DB_PORT=5432
DB_DATABASE=laravel_gis_prod
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com

# Broadcasting & Queue
BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Cache
CACHE_STORE=redis
CACHE_PREFIX=laravel_gis_prod

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379
REDIS_DB=0

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# GeoServer Configuration
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=your_secure_geoserver_password_here
GEOSERVER_WORKSPACE=production
GEOSERVER_DATASTORE=postgis_store_prod

# Data Import Configuration
OGR2OGR_PATH=/usr/bin/ogr2ogr
OGRINFO_PATH=/usr/bin/ogrinfo
DATA_IMPORT_DISK=local
DATA_IMPORT_MAX_FILE_SIZE=104857600
DATA_IMPORT_TABLE_PREFIX=import_
DATA_IMPORT_DEFAULT_SRID=4326
DATA_IMPORT_TIMEOUT=300

# Monitoring & Performance
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
PULSE_ENABLED=true

# Error Tracking (e.g., Sentry)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Slack Notifications
LOG_SLACK_WEBHOOK_URL=

# Backup Configuration
BACKUP_KEEP_DAYS=30
DB_BACKUP_ENABLED=true

# Performance
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=256
PHP_MAX_EXECUTION_TIME=300
PHP_MEMORY_LIMIT=512M

# Security
SECURE_COOKIES=true
SAME_SITE_COOKIES=strict
